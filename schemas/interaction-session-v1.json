{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fes/vm-evidence-lab/schemas/interaction-session-v1.json",
  "title": "VM evidence interaction session v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "platform",
    "run_id",
    "target",
    "grants",
    "limits"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "platform": { "enum": ["windows", "linux", "macos"] },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid"],
      "properties": {
        "pid": { "type": "integer", "minimum": 1 },
        "window_index": { "type": "integer", "minimum": 0, "maximum": 31 }
      }
    },
    "grants": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "observe",
          "keyboard",
          "pointer",
          "wheel",
          "accessibility",
          "screenshot",
          "video",
          "clipboard-sentinel",
          "fixture-files"
        ]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_commands",
        "command_timeout_ms",
        "maximum_artifact_bytes",
        "maximum_video_seconds"
      ],
      "properties": {
        "maximum_commands": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "command_timeout_ms": { "type": "integer", "minimum": 100, "maximum": 120000 },
        "maximum_artifact_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "maximum_video_seconds": { "type": "integer", "minimum": 1, "maximum": 300 }
      }
    }
  }
}
