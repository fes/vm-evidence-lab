{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fes/vm-evidence-lab/schemas/job-v1.json",
  "title": "VM evidence guest job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "adapter_id",
    "adapter_sha",
    "adapter_schema_version",
    "mode",
    "platform",
    "sources",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "adapter_sha": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "adapter_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "platform": {
      "enum": ["windows", "linux", "macos"]
    },
    "sources": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sha", "bundle"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "sha": {
            "type": "string",
            "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "bundle": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}\\.bundle$"
          }
        }
      }
    },
    "payload": {
      "type": "object"
    }
  }
}
