$ErrorActionPreference = 'Continue'
Start-Transcript -Path C:\Windows\Temp\setup-evidence.log -Force

$cap = Get-WindowsCapability -Online -Name 'OpenSSH.Server*' | Select-Object -First 1
if ($cap.State -ne 'Installed') { Add-WindowsCapability -Online -Name $cap.Name }

Set-Service -Name sshd -StartupType Automatic
Start-Service sshd

$key = '@SSH_PUBLIC_KEY@ vm-evidence-lab'
$file = 'C:\ProgramData\ssh\administrators_authorized_keys'
Set-Content -Path $file -Value $key -Encoding ascii
icacls.exe $file /inheritance:r /grant 'SYSTEM:F' /grant 'Administrators:F' | Out-Null

if (-not (Get-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -ErrorAction SilentlyContinue)) {
    New-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -DisplayName 'OpenSSH Server' -Enabled True -Direction Inbound -Protocol TCP -Action Allow -LocalPort 22
}
# Parallels Shared networking is classified Public, so the rule must apply to every profile.
Set-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -Profile Any
Get-NetConnectionProfile | Set-NetConnectionProfile -NetworkCategory Private

powercfg.exe /change standby-timeout-ac 0
powercfg.exe /change monitor-timeout-ac 0
powercfg.exe /hibernate off
Stop-Transcript
