{
  "schema_version": 1,
  "platform": "windows",
  "modes": ["os-input-smoke"],
  "initial_timeout_seconds": 60,
  "stage_timeout_seconds": 10,
  "stages": [
    {
      "wait_for": "ready",
      "settle_seconds": 0,
      "inter_event_milliseconds": 0,
      "first_event_pause_milliseconds": 0,
      "events": [
        {"type": "pointer-button", "code": 178},
        {"type": "key", "code": 23}
      ]
    },
    {
      "wait_for": "confirmed",
      "settle_seconds": 0,
      "inter_event_milliseconds": 0,
      "first_event_pause_milliseconds": 0,
      "events": [
        {"type": "key", "code": 98}
      ]
    }
  ]
}
